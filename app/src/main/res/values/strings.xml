    <!-- Why-this-score sheet -->
    <string name="score_explain_title">Из чего складывается оценка</string>
    <string name="score_explain_intro">Оценка показывает, какая часть установленных вами приложений имеет доступ к чувствительным функциям телефона. Это не оценка защищённости и не результат проверки на угрозы.</string>
