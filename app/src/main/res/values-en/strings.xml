    <!-- ============================ Privacy policy screen ============================ -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_headline">Your data stays on this device</string>
    <string name="privacy_point_local_title">Local analysis</string>
    <string name="privacy_point_local_body">The list of installed apps and the permissions they hold are read on the device and stored in the app\'s local database.</string>
    <string name="privacy_point_no_internet_title">No internet access</string>
    <string name="privacy_point_no_internet_body">PermAware does not declare the INTERNET permission. The app is technically unable to send anything to the developer or to anyone else.</string>
    <string name="privacy_point_no_analytics_title">No analytics, no ads</string>
    <string name="privacy_point_no_analytics_body">There are no advertising SDKs, analytics systems or trackers in the app. No account is needed.</string>
    <string name="privacy_point_backup_title">No cloud copies</string>
    <string name="privacy_point_backup_body">Backup of app data is turned off, so check results never reach the cloud.</string>
    <string name="privacy_point_boosty_title">Opening Boosty</string>
    <string name="privacy_point_boosty_body">The “Support the developer” button opens an external site in your browser. Nothing is added to the link. Boosty operates under its own privacy policy.</string>

