    <!-- Why-this-score sheet -->
    <string name="score_explain_title">How the score is calculated</string>
    <string name="score_explain_intro">The score reflects how many of the apps you installed can reach sensitive parts of your phone. It is not a security rating and not the result of a threat scan.</string>
