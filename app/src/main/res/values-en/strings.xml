    <string name="onboarding_1_title">Keep track of app permissions</string>
    <string name="onboarding_1_body">PermAware shows which apps can reach your camera, microphone, location and contacts — and what changed after an update.</string>

    <string name="onboarding_2_title">Your data stays on this device</string>
    <string name="onboarding_2_body">The list of apps and the results of every check are processed locally. No account, no ads, no tracking.</string>
    <string name="onboarding_2_point_local">Everything is analysed on your device</string>
    <string name="onboarding_2_point_no_internet">The app has no internet permission</string>
    <string name="onboarding_2_point_no_account">No account, no sign-up</string>

    <string name="onboarding_3_title">First check</string>
    <string name="onboarding_3_body">The check takes a few seconds. Its result becomes the baseline: from the next one on, PermAware can show you what changed.</string>
    <string name="onboarding_3_action">Check my apps</string>

    <string name="onboarding_disclosure_title">PermAware reads your list of installed apps</string>
    <string name="onboarding_disclosure_body">To show which apps can reach your camera, microphone, location and contacts, the app reads the list of installed apps and the permissions they hold.\n\nThat analysis happens entirely on your device. Neither the list of apps nor the results of any check are sent to the developer or to anyone else — the app does not even hold the permission needed to reach the internet.</string>

