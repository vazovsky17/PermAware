    <string name="about_title">About</string>
    <string name="about_studio">Vazovsky Studio</string>
    <string name="about_tagline">A small studio: one developer and a great deal of attention to detail.</string>
    <string name="about_body">PermAware does not hunt for viruses or frighten you with red shields. It shows what your apps can already do and explains it in plain language. It has no internet permission at all — your app list has nowhere to go.</string>
    <string name="about_craft_title">Made by hand</string>
    <string name="about_craft_body">Every shade is checked for contrast, every screen at a large font size, and every number on the dashboard can be recounted in the app list. If you find a mismatch, that is a bug and I want to hear about it.</string>
    <string name="about_source_title">The source is open</string>
    <string name="about_source_body">Do not take my word for it — look for yourself.</string>
    <string name="about_support_title">Support the studio</string>
    <string name="about_support_body">Unlocks nothing and switches nothing off. Just thank you.</string>
    <string name="about_contact_title">Found a bug?</string>
    <string name="about_contact_body">Send me a message on Telegram and I will fix it.</string>
    <string name="about_version">Version %1$s</string>
    <string name="settings_what_app_cannot">What PermAware does not do</string>
    <string name="settings_disclaimer">PermAware is not an antivirus. It does not look for malware and it cannot tell you whether an app is spying on you. It shows what access apps have to your device, and what has changed about that access.</string>

    <!-- ============================ Support the developer ============================ -->
    <string name="support_title">Support the developer</string>
    <string name="support_body">PermAware is free, with no ads and no tracking. If you find it useful, you can support its development.</string>
    <string name="support_action">Support on Boosty</string>
    <string name="support_dismiss">Hide</string>
