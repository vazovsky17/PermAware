app/build/

# Signing material. Three rules for one file, because the one thing that must never happen to a
# release keystore is that it is committed: the directory the build reads it from, the keystore
# extensions themselves, and the properties files that hold its passwords.
#
# Nothing in here is recoverable if it leaks, and nothing in here is recoverable if it is
# lost — keep an offline backup outside this repository.
/signKeystore/
*.jks
*.keystore
key.properties
keystore.properties
signing.properties

